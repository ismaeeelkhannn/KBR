# ==========================================
# Khan Burger - Environment Template
# Ye file Git mein jayegi. Yahan real password mat likhein.
# Asal values `.env` file mein likhein.
# ==========================================

# App
NODE_ENV=development
APP_TIMEZONE=Asia/Karachi
APP_CURRENCY=PKR

# PostgreSQL (Docker Compose ke liye)
POSTGRES_USER=kbr_user
POSTGRES_PASSWORD=change_this_password
POSTGRES_DB=khan_burger
POSTGRES_PORT=5432

# Prisma / Application database connection
DATABASE_URL=postgresql://kbr_user:change_this_password@localhost:5432/khan_burger?schema=public

# Session secret (kam se kam 32 characters). Production mein lamba random string use karein.
SESSION_SECRET=replace_with_at_least_32_random_characters_here

# DEMO owner (sirf development ke liye). Password kam se kam 12 characters.
DEMO_OWNER_USERNAME=owner
DEMO_OWNER_FULLNAME=DEMO Owner
DEMO_OWNER_PASSWORD=replace_with_12plus_char_password
