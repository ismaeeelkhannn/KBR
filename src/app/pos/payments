@'
"use client";

import { useState } from "react";
import { AlertTriangle, CheckCircle2 } from "lucide-react";

type Order = {
  id: string;
  orderNumber: string;
  orderType: string;
  totalPaisa: number;
  createdAt: string;
};

type Method = "CASH" | "JAZZCASH" | "EASYPAISA" | "BANK_TRANSFER" | "CARD";

const METHODS: { value: Method; label: string }[] = [
  { value: "CASH", label: "Cash" },
  { value: "JAZZCASH", label: "JazzCash" },
  { value: "EASYPAISA", label: "Easypaisa" },
  { value: "BANK_TRANSFER", label: "Bank" },
  { value: "CARD", label: "Card" },
];

const rs = (p: number) => "Rs. " + (p / 100).toLocaleString("en-PK", { maximumFractionDigits: 0 });

export function PaymentsClient({
  shiftId,
  orders: initial,
}: {
  shiftId: string | null;
  orders: Order[];
}) {
  const [orders, setOrders] = useState(initial);
  const [busyId, setBusyId] = useState<string | null>(null);
  const [method, setMethod] = useState<Method>("CASH");
  const [reference, setReference] = useState("");
  const [message, setMessage] = useState<{ kind: "ok" | "err"; text: string } | null>(null);

  const label = METHODS.find((m) => m.value === method)?.label ?? method;
  const needsReference = method !== "CASH";

  async function pay(o: Order) {
    if (!shiftId || busyId) return;
    if (needsReference && reference.trim().length < 3) {
      setMessage({ kind: "err", text: `${label} ke liye reference number likhein (kam az kam 3 characters)` });
      return;
    }

    setBusyId(o.id);
    setMessage(null);
    try {
      const res = await fetch(`/api/orders/${o.id}/pay`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          idempotencyKey: crypto.randomUUID(),
          cashShiftId: shiftId,
          method,
          amountPaisa: o.totalPaisa,
          ...(reference.trim() ? { reference: reference.trim() } : {}),
        }),
      });
      const data = await res.json().catch(() => ({}));
      if (!res.ok) {
        setMessage({ kind: "err", text: data.error ?? `Payment nahi hua (${res.status})` });
        return;
      }
      setOrders((prev) => prev.filter((x) => x.id !== o.id));
      setReference("");
      setMessage({ kind: "ok", text: `${o.orderNumber} ka ${rs(o.totalPaisa)} ${label} se ho gaya` });
    } catch {
      setMessage({ kind: "err", text: "Network ka masla hai, dobara try karein" });
    } finally {
      setBusyId(null);
    }
  }

  return (
    <div className="space-y-4">
      {!shiftId && (
        <div className="flex items-start gap-2 rounded-xl border border-amber-500/30 bg-amber-500/10 p-4 text-sm text-amber-300">
          <AlertTriangle className="mt-0.5 h-4 w-4 shrink-0" />
          <span>Aap ka koi open cash shift nahi hai. Payment lene se pehle shift kholen.</span>
        </div>
      )}

      <div className="rounded-2xl border border-[#1f2a44] bg-[#151d33] p-4">
        <p className="mb-3 text-xs font-semibold uppercase tracking-wider text-slate-500">Payment method</p>
        <div className="grid grid-cols-2 gap-2 sm:grid-cols-5">
          {METHODS.map((m) => (
            <button
              key={m.value}
              type="button"
              onClick={() => setMethod(m.value)}
              className={`rounded-xl py-2.5 text-sm font-medium transition ${
                method === m.value
                  ? "bg-orange-500 text-white shadow-lg shadow-orange-500/20"
                  : "bg-[#0f1629] text-slate-400 hover:text-white"
              }`}
            >
              {m.label}
            </button>
          ))}
        </div>
        {needsReference && (
          <input
            value={reference}
            onChange={(e) => setReference(e.target.value)}
            placeholder="Transaction / reference number"
            maxLength={100}
            className="mt-3 w-full rounded-xl border border-[#1f2a44] bg-[#0f1629] px-4 py-2.5 text-sm text-white placeholder:text-slate-600 focus:border-orange-500 focus:outline-none"
          />
        )}
      </div>

      {message && (
        <div
          className={`flex items-start gap-2 rounded-xl p-4 text-sm ${
            message.kind === "ok" ? "bg-green-500/10 text-green-400" : "bg-red-500/10 text-red-400"
          }`}
        >
          {message.kind === "ok" && <CheckCircle2 className="mt-0.5 h-4 w-4 shrink-0" />}
          <span>{message.text}</span>
        </div>
      )}

      {orders.length === 0 ? (
        <p className="rounded-2xl border border-dashed border-[#1f2a44] py-12 text-center text-sm text-slate-500">
          Koi served order payment ke liye nahi hai.
        </p>
      ) : (
        <div className="grid grid-cols-1 gap-4 sm:grid-cols-2 xl:grid-cols-3">
          {orders.map((o) => (
            <div key={o.id} className="rounded-2xl border border-[#1f2a44] bg-[#151d33] p-5">
              <div className="flex items-center justify-between">
                <p className="font-semibold text-white">{o.orderNumber}</p>
                <span className="text-xs text-slate-400">{o.orderType}</span>
              </div>
              <p className="mt-1 text-xs text-slate-500">
                {new Date(o.createdAt).toLocaleTimeString("en-PK", {
                  timeZone: "Asia/Karachi",
                  hour: "2-digit",
                  minute: "2-digit",
                })}
              </p>
              <p className="mt-4 text-2xl font-bold text-white">{rs(o.totalPaisa)}</p>
              <button
                type="button"
                onClick={() => pay(o)}
                disabled={!shiftId || busyId !== null}
                className="mt-4 w-full rounded-xl bg-orange-500 py-2.5 text-sm font-semibold text-white transition hover:bg-orange-600 disabled:cursor-not-allowed disabled:opacity-40"
              >
                {busyId === o.id ? "Ho raha hai..." : `${label} se pay karein`}
              </button>
            </div>
          ))}
        </div>
      )}
    </div>
  );
}
