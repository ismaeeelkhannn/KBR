@'
import { connection } from "next/server";
import { redirect } from "next/navigation";
import { db } from "@/lib/db";
import { getCurrentUser } from "@/modules/auth/session";
import { AppShell } from "@/components/app-shell/app-shell";
import { PaymentsClient } from "./payments-client";

export default async function PaymentsPage() {
  await connection();
  const user = await getCurrentUser();
  if (!user) redirect("/login");

  const branch = await db.branch.findFirst();
  if (!branch)
    return (
      <AppShell userName={user.fullName} role={user.role.name}>
        <p className="text-slate-400">Branch nahi mili.</p>
      </AppShell>
    );

  const [shift, orders] = await Promise.all([
    db.cashShift.findFirst({
      where: { branchId: branch.id, status: "OPEN", openedById: user.id },
      select: { id: true },
    }),
    db.order.findMany({
      where: { branchId: branch.id, status: "SERVED" },
      orderBy: { createdAt: "asc" },
      take: 50,
      select: { id: true, orderNumber: true, orderType: true, totalPaisa: true, createdAt: true },
    }),
  ]);

  return (
    <AppShell userName={user.fullName} role={user.role.name}>
      <div className="space-y-6">
        <div>
          <h1 className="text-2xl font-bold tracking-tight text-white">Payments</h1>
          <p className="text-sm text-slate-400">Served orders ka payment lein</p>
        </div>
        <PaymentsClient
          shiftId={shift?.id ?? null}
          orders={orders.map((o) => ({ ...o, createdAt: o.createdAt.toISOString() }))}
        />
      </div>
    </AppShell>
  );
}
