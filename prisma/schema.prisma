// Khan Burger - Prisma schema
// Batch 3: Identity (users, roles, permissions), branches, sessions, employees, cash registers.
// Rules:
// - Money hamesha paisa (Int) mein. Kabhi float nahi.
// - Branch aur user hard delete nahi honge (isActive / deletedAt).
// - Financial aur audit tables mein cascade delete nahi.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
  TERMINATED
}

enum CancellationReasonCode {
  CUSTOMER_CHANGED_MIND
  WRONG_ORDER
  CUSTOMER_NOT_RESPONDING
  PAYMENT_ISSUE
  DELIVERY_PROBLEM
  PREPARATION_DELAY
  OUT_OF_STOCK
  OTHER
}

// ---------- Identity & Access ----------

model Role {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String?
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       User[]
  permissions RolePermission[]
}

model Permission {
  id          String   @id @default(cuid())
  code        String   @unique
  description String?
  createdAt   DateTime @default(now())

  roles RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  createdAt    DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Restrict)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  @@id([roleId, permissionId])
}

model User {
  id               String    @id @default(cuid())
  username         String    @unique
  fullName         String
  passwordHash     String
  roleId           String
  isActive         Boolean   @default(true)
  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?
  lastLoginAt      DateTime?
  deletedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  role                Role               @relation(fields: [roleId], references: [id], onDelete: Restrict)
  branchAccess        UserBranchAccess[]
  sessions            Session[]
  employee            Employee?
  orders              Order[]
  statusEvents        OrderStatusEvent[]
  approvalsRequested  Approval[]         @relation("ApprovalRequester")
  approvalsDecided    Approval[]         @relation("ApprovalDecider")
  auditLogs           AuditLog[]
  openedShifts        CashShift[]        @relation("ShiftOpener")
  closedShifts        CashShift[]        @relation("ShiftCloser")
  payments            Payment[]          @relation("PaymentCreator")
  stockMovements      StockMovement[]    @relation("StockCreator")
  deliveryAssignments DeliveryDetail[]   @relation("DeliveryRider")
  recipeVersions      RecipeVersion[]    @relation("RecipeCreator")
  managedEmployees    Employee[]         @relation("EmployeeManager")
  employeeSalaryRecords EmployeeSalary[]  @relation("EmployeeSalaryCreator")

  @@index([roleId])
}

model Session {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique
  expiresAt  DateTime
  lastSeenAt DateTime?
  ipAddress  String?
  userAgent  String?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// ---------- Branches ----------

model Branch {
  id        String    @id @default(cuid())
  code      String    @unique
  name      String
  address   String?
  phone     String?
  timezone  String    @default("Asia/Karachi")
  isActive  Boolean   @default(true)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  userAccess     UserBranchAccess[]
  employees      Employee[]
  cashRegisters  CashRegister[]
  orders         Order[]
  cashShifts     CashShift[]
  stockMovements StockMovement[]
}

model UserBranchAccess {
  userId    String
  branchId  String
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)

  @@id([userId, branchId])
  @@index([branchId])
}

model CashRegister {
  id        String   @id @default(cuid())
  branchId  String
  code      String
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branch     Branch      @relation(fields: [branchId], references: [id], onDelete: Restrict)
  cashShifts CashShift[]

  @@unique([branchId, code])
}

// ---------- Staff ----------

model Employee {
  id                 String         @id @default(cuid())
  employeeCode       String         @unique
  userId             String?        @unique
  branchId           String
  departmentId       String?
  assignedManagerId  String?
  fullName           String
  phone              String?
  email              String?
  address            String?
  cnic               String?
  profilePictureUrl  String?
  emergencyContact   String?
  emergencyPhone     String?
  jobTitle           String
  joiningDate        DateTime
  monthlySalaryPaisa Int
  status             EmployeeStatus @default(ACTIVE)
  deletedAt          DateTime?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  user             User?             @relation(fields: [userId], references: [id], onDelete: Restrict)
  branch           Branch            @relation(fields: [branchId], references: [id], onDelete: Restrict)
  department       EmployeeDepartment? @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  assignedManager  User?             @relation("EmployeeManager", fields: [assignedManagerId], references: [id], onDelete: Restrict)
  salaryVersions   EmployeeSalary[]

  @@index([branchId])
  @@index([departmentId])
  @@index([assignedManagerId])
  @@index([status, branchId])
  @@index([fullName])
}

model EmployeeDepartment {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String?
  isActive    Boolean  @default(true)
  deletedAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  employees Employee[]

  @@index([isActive])
}

model EmployeeSalary {
  id                 String   @id @default(cuid())
  employeeId         String
  monthlySalaryPaisa Int
  effectiveFrom      DateTime
  effectiveTo        DateTime?
  createdById        String
  createdAt          DateTime @default(now())
  note               String?

  employee  Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  createdBy User     @relation("EmployeeSalaryCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@unique([employeeId, effectiveFrom])
  @@index([employeeId, effectiveFrom])
}

// ---------- Catalog (Batch 6) ----------
// Rule: price hamesha paisa (Int). Price badalne par naya PriceVersion banega, purana update nahi hoga.

model Category {
  id        String    @id @default(cuid())
  code      String    @unique
  name      String
  sortOrder Int       @default(0)
  isActive  Boolean   @default(true)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  products Product[]
}

model Product {
  id          String    @id @default(cuid())
  categoryId  String
  code        String    @unique
  name        String
  description String?
  isActive    Boolean   @default(true)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  category Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  variants ProductVariant[]

  @@index([categoryId])
}

model ProductVariant {
  id        String    @id @default(cuid())
  productId String
  code      String    @unique
  name      String
  isActive  Boolean   @default(true)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  product        Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  prices         PriceVersion[]
  orderItems     OrderItem[]
  recipeVersions RecipeVersion[]

  @@index([productId])
}

model PriceVersion {
  id            String   @id @default(cuid())
  variantId     String
  amountPaisa   Int
  effectiveFrom DateTime @default(now())
  isVerified    Boolean  @default(false) // owner verify kare to true
  note          String?
  createdAt     DateTime @default(now())

  variant    ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  orderItems OrderItem[]

  @@index([variantId, effectiveFrom])
}

// ---------- Orders (Batch 7) ----------
// Rules:
// - Price snapshot: order item mein unitPricePaisa save hota hai. Baad mein price badle to purana order nahi badlega.
// - Idempotency: idempotencyKey unique hai. Same key par dobara duplicate order nahi banega.
// - Totals sirf server calculate karta hai.

enum OrderStatus {
  CONFIRMED
  PREPARING
  READY
  SERVED
  PAID
  CANCELLED
}

enum OrderType {
  DINE_IN
  TAKEAWAY
  DELIVERY
}

model Order {
  id             String      @id @default(cuid())
  orderNumber    String
  branchId       String
  createdById    String
  orderType      OrderType   @default(TAKEAWAY)
  status         OrderStatus @default(CONFIRMED)
  customerName   String?     @db.VarChar(100)
  idempotencyKey String      @unique
  subtotalPaisa  Int
  discountPaisa  Int         @default(0)
  totalPaisa     Int
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  branch       Branch             @relation(fields: [branchId], references: [id], onDelete: Restrict)
  createdBy    User               @relation(fields: [createdById], references: [id], onDelete: Restrict)
  items        OrderItem[]
  statusEvents OrderStatusEvent[]
  payments     Payment[]

  @@unique([branchId, orderNumber])
  @@index([branchId, createdAt])
}

model OrderItem {
  id                  String  @id @default(cuid())
  orderId             String
  variantId           String
  priceVersionId      String
  recipeVersionId     String?
  productNameSnapshot String
  variantNameSnapshot String
  unitPricePaisa      Int
  quantity            Int
  lineTotalPaisa      Int
  note                String?

  order         Order          @relation(fields: [orderId], references: [id], onDelete: Restrict)
  variant       ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  priceVersion  PriceVersion   @relation(fields: [priceVersionId], references: [id], onDelete: Restrict)
  recipeVersion RecipeVersion? @relation(fields: [recipeVersionId], references: [id], onDelete: Restrict)

  @@index([orderId])
}

// ---------- Order status history (Batch 8) ----------
// Har status change ka record. Delete ya update nahi hota.

model OrderStatusEvent {
  id          String      @id @default(cuid())
  orderId     String
  fromStatus  OrderStatus
  toStatus    OrderStatus
  changedById String
  reason      String?
  createdAt   DateTime    @default(now())

  order     Order @relation(fields: [orderId], references: [id], onDelete: Restrict)
  changedBy User  @relation(fields: [changedById], references: [id], onDelete: Restrict)

  @@index([orderId, createdAt])
  @@index([toStatus, createdAt])
}

// ---------- Approvals, Outbox, Audit (Batch 9) ----------

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum OutboxStatus {
  PENDING
  SENT
  FAILED
}

model Approval {
  id            String                  @id @default(cuid())
  type          String // "ORDER_CANCEL"
  entityType    String // "Order"
  entityId      String
  status        ApprovalStatus          @default(PENDING)
  reason        String
  reasonCode    CancellationReasonCode?
  decisionNote  String?
  requestedById String
  decidedById   String?
  createdAt     DateTime                @default(now())
  decidedAt     DateTime?

  requestedBy User  @relation("ApprovalRequester", fields: [requestedById], references: [id], onDelete: Restrict)
  decidedBy   User? @relation("ApprovalDecider", fields: [decidedById], references: [id], onDelete: Restrict)

  @@index([entityType, entityId])
  @@index([status, createdAt])
  @@index([type, status, decidedAt])
  @@index([requestedById, decidedAt])
}

// Notification ya side-effect ka pakka record. Worker yahin se padhta hai.
model OutboxEvent {
  id        String       @id @default(cuid())
  type      String
  payload   Json
  status    OutboxStatus @default(PENDING)
  attempts  Int          @default(0)
  lastError String?
  createdAt DateTime     @default(now())
  sentAt    DateTime?

  @@index([status, createdAt])
}

// Append-only. App ko is table par UPDATE/DELETE ka kaam nahi dena.
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String
  action     String
  entityType String
  entityId   String
  before     Json?
  after      Json?
  reason     String?
  createdAt  DateTime @default(now())

  actor User @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([entityType, entityId])
  @@index([actorId, createdAt])
}

// ---------- Cash shifts (Batch 10) ----------
// Rule: paisa mein. Shift band hone ke baad uska record change nahi hota.

enum CashShiftStatus {
  OPEN
  CLOSED
}

model CashShift {
  id                String          @id @default(cuid())
  branchId          String
  cashRegisterId    String
  openedById        String
  closedById        String?
  status            CashShiftStatus @default(OPEN)
  openingCashPaisa  Int
  expectedCashPaisa Int?
  countedCashPaisa  Int?
  variancePaisa     Int?
  varianceReason    String?
  openedAt          DateTime        @default(now())
  closedAt          DateTime?

  branch       Branch       @relation(fields: [branchId], references: [id], onDelete: Restrict)
  cashRegister CashRegister @relation(fields: [cashRegisterId], references: [id], onDelete: Restrict)
  openedBy     User         @relation("ShiftOpener", fields: [openedById], references: [id], onDelete: Restrict)
  closedBy     User?        @relation("ShiftCloser", fields: [closedById], references: [id], onDelete: Restrict)
  payments     Payment[]

  @@index([cashRegisterId, status])
  @@index([branchId, openedAt])
}

// ---------- Payments (Batch 10 Part 2) ----------

enum PaymentMethod {
  CASH
  JAZZCASH
  EASYPAISA
  BANK_TRANSFER
  CARD
}

enum PaymentStatus {
  COMPLETED
  REVERSED
}

// Ek order ki ek hi payment (abhi partial payment nahi). Reversal ke liye status badlega, row delete nahi hogi.
model Payment {
  id             String        @id @default(cuid())
  orderId        String        @unique
  cashShiftId    String
  method         PaymentMethod
  status         PaymentStatus @default(COMPLETED)
  amountPaisa    Int
  reference      String?
  idempotencyKey String        @unique
  createdById    String
  createdAt      DateTime      @default(now())

  order     Order     @relation(fields: [orderId], references: [id], onDelete: Restrict)
  cashShift CashShift @relation(fields: [cashShiftId], references: [id], onDelete: Restrict)
  createdBy User      @relation("PaymentCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([cashShiftId, method, status])
}

// ---------- Inventory ledger (Batch 11) ----------
// Unit: g, ml, pcs (base units). Quantities integer hain.

enum StockMovementType {
  STORE_ISSUE
  PURCHASE
  SALE_DEDUCTION
  WASTAGE
  ADJUSTMENT
}

model InventoryItem {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  unit      String // "g", "ml", "pcs"
  createdAt DateTime @default(now())

  recipeVersionLines RecipeVersionLine[]
  stockMovements     StockMovement[]
  purchaseLines      PurchaseLine[]
}

// Append-only ledger. Quantity negative = stock out, positive = stock in.
model StockMovement {
  id              String            @id @default(cuid())
  branchId        String
  inventoryItemId String
  type            StockMovementType
  quantityBase    Int
  orderId         String?
  reason          String?
  createdById     String
  createdAt       DateTime          @default(now())

  branch        Branch        @relation(fields: [branchId], references: [id], onDelete: Restrict)
  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)
  createdBy     User          @relation("StockCreator", fields: [createdById], references: [id], onDelete: Restrict)

  // Ek order par ek item ki ek hi deduction
  @@unique([orderId, inventoryItemId, type])
  @@index([branchId, inventoryItemId])
}

// ---------- Recipe versions (Batch 12) ----------
// Har recipe change naya version. Purana version kabhi edit nahi hota.

model RecipeVersion {
  id          String   @id @default(cuid())
  variantId   String
  version     Int
  createdById String
  createdAt   DateTime @default(now())

  variant    ProductVariant      @relation(fields: [variantId], references: [id], onDelete: Restrict)
  createdBy  User                @relation("RecipeCreator", fields: [createdById], references: [id], onDelete: Restrict)
  lines      RecipeVersionLine[]
  orderItems OrderItem[]

  @@unique([variantId, version])
}

model RecipeVersionLine {
  id              String @id @default(cuid())
  recipeVersionId String
  inventoryItemId String
  quantityBase    Int

  recipeVersion RecipeVersion @relation(fields: [recipeVersionId], references: [id], onDelete: Restrict)
  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)

  @@unique([recipeVersionId, inventoryItemId])
}

// ---------- Purchases and expenses (Batch 13) ----------
// Financial records use paisa and are retained rather than deleted.

model Purchase {
  id             String         @id @default(cuid())
  branchId       String
  supplierName   String?        @db.VarChar(120)
  invoiceNo      String?        @db.VarChar(60)
  totalPaisa     Int
  idempotencyKey String         @unique
  createdById    String
  createdAt      DateTime       @default(now())
  lines          PurchaseLine[]

  @@index([branchId, createdAt])
}

model PurchaseLine {
  id              String        @id @default(cuid())
  purchaseId      String
  purchase        Purchase      @relation(fields: [purchaseId], references: [id], onDelete: Restrict)
  inventoryItemId String
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)
  quantityBase    Int
  lineTotalPaisa  Int

  @@index([purchaseId])
}

model Expense {
  id             String   @id @default(cuid())
  branchId       String
  category       String   @db.VarChar(60)
  description    String   @db.VarChar(200)
  amountPaisa    Int
  expenseDate    DateTime
  idempotencyKey String   @unique
  createdById    String
  createdAt      DateTime @default(now())

  @@index([branchId, expenseDate])
}

model DailyClosing {
  id             String   @id @default(cuid())
  branchId       String
  businessDate   String   @db.VarChar(10)
  salesPaisa     Int
  expensesPaisa  Int
  purchasesPaisa Int
  snapshot       Json
  closedById     String
  closedAt       DateTime @default(now())

  @@unique([branchId, businessDate])
}

enum ComplaintStatus {
  OPEN
  IN_REVIEW
  RESOLVED
  REJECTED
}

model Complaint {
  id           String           @id @default(cuid())
  branchId     String
  orderId      String?
  customerName String?          @db.VarChar(100)
  phone        String?          @db.VarChar(20)
  category     String           @db.VarChar(60)
  description  String           @db.VarChar(1000)
  status       ComplaintStatus  @default(OPEN)
  resolution   String?          @db.VarChar(500)
  resolvedById String?
  resolvedAt   DateTime?
  createdById  String
  createdAt    DateTime         @default(now())
  events       ComplaintEvent[]

  @@index([branchId, status])
}

model ComplaintEvent {
  id          String           @id @default(cuid())
  complaintId String
  complaint   Complaint        @relation(fields: [complaintId], references: [id], onDelete: Restrict)
  fromStatus  ComplaintStatus?
  toStatus    ComplaintStatus
  note        String           @db.VarChar(500)
  changedById String
  createdAt   DateTime         @default(now())

  @@index([complaintId])
}

enum DeliveryStatus {
  PENDING
  DISPATCHED
  DELIVERED
  FAILED
}

model DeliveryDetail {
  id           String         @id @default(cuid())
  orderId      String         @unique
  branchId     String
  customerName String         @db.VarChar(100)
  phone        String         @db.VarChar(20)
  address      String         @db.VarChar(300)
  riderUserId  String?
  riderName    String?        @db.VarChar(100)
  status       DeliveryStatus @default(PENDING)
  dispatchedAt DateTime?
  deliveredAt  DateTime?
  createdAt    DateTime       @default(now())

  rider User? @relation("DeliveryRider", fields: [riderUserId], references: [id], onDelete: Restrict)

  @@index([branchId, status])
  @@index([riderUserId, status])
}
enum StoreRequisitionStatus {
  REQUESTED
  APPROVED
  PARTIAL
  REJECTED
  ISSUED
  CANCELLED
}

model StoreRequisition {
  id                      String                 @id @default(cuid())
  branchId                String
  requisitionNo           String
  requestedById           String
  requesterEmployeeId     String?
  purpose                 String?
  status                  StoreRequisitionStatus @default(REQUESTED)
  totalPaisa              Int                    @default(0)
  requiresManagerApproval Boolean                @default(false)
  approvedById            String?
  approvedAt              DateTime?
  managerApprovedById     String?
  managerApprovedAt       DateTime?
  rejectReason            String?
  issuedById              String?
  issuedAt                DateTime?
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt
  lines                   StoreRequisitionLine[]
  voucher                 StoreIssueVoucher?

  @@unique([branchId, requisitionNo])
  @@index([branchId, status])
  @@index([requestedById])
}

model StoreRequisitionLine {
  id              String           @id @default(cuid())
  requisitionId   String
  requisition     StoreRequisition @relation(fields: [requisitionId], references: [id], onDelete: Restrict)
  inventoryItemId String
  requestedQty    Int
  approvedQty     Int              @default(0)
  issuedQty       Int              @default(0)
  unitCostPaisa   Int              @default(0)
  lineTotalPaisa  Int              @default(0)
  note            String?

  @@index([requisitionId])
  @@index([inventoryItemId])
}

model StoreIssueVoucher {
  id              String           @id @default(cuid())
  branchId        String
  voucherNo       String
  requisitionId   String           @unique
  requisition     StoreRequisition @relation(fields: [requisitionId], references: [id], onDelete: Restrict)
  totalPaisa      Int
  issuedById      String
  receivedById    String
  verifyMethod    String
  createdAt       DateTime         @default(now())

  @@unique([branchId, voucherNo])
}

model StoreStaffPin {
  id        String   @id @default(cuid())
  userId    String   @unique
  pinHash   String
  updatedAt DateTime @updatedAt
}


