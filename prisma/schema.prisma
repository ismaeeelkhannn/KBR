// Khan Burger - Prisma schema
// Batch 3: Identity (users, roles, permissions), branches, sessions, employees, cash registers.
// Rules:
// - Money hamesha paisa (Int) mein. Kabhi float nahi.
// - Branch aur user hard delete nahi honge (isActive / deletedAt).
// - Financial aur audit tables mein cascade delete nahi.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
  TERMINATED
}

// ---------- Identity & Access ----------

model Role {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String?
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       User[]
  permissions RolePermission[]
}

model Permission {
  id          String   @id @default(cuid())
  code        String   @unique
  description String?
  createdAt   DateTime @default(now())

  roles RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  createdAt    DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Restrict)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  @@id([roleId, permissionId])
}

model User {
  id               String    @id @default(cuid())
  username         String    @unique
  fullName         String
  passwordHash     String
  roleId           String
  isActive         Boolean   @default(true)
  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?
  lastLoginAt      DateTime?
  deletedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  role         Role               @relation(fields: [roleId], references: [id], onDelete: Restrict)
  branchAccess UserBranchAccess[]
  sessions     Session[]
  employee     Employee?
  orders       Order[]

  @@index([roleId])
}

model Session {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique
  expiresAt  DateTime
  lastSeenAt DateTime?
  ipAddress  String?
  userAgent  String?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// ---------- Branches ----------

model Branch {
  id        String    @id @default(cuid())
  code      String    @unique
  name      String
  address   String?
  phone     String?
  timezone  String    @default("Asia/Karachi")
  isActive  Boolean   @default(true)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  userAccess    UserBranchAccess[]
  employees     Employee[]
  cashRegisters CashRegister[]
  orders        Order[]
}

model UserBranchAccess {
  userId    String
  branchId  String
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)

  @@id([userId, branchId])
  @@index([branchId])
}

model CashRegister {
  id        String   @id @default(cuid())
  branchId  String
  code      String
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)

  @@unique([branchId, code])
}

// ---------- Staff ----------

model Employee {
  id                 String         @id @default(cuid())
  employeeCode       String         @unique
  userId             String?        @unique
  branchId           String
  fullName           String
  phone              String?
  jobTitle           String
  joiningDate        DateTime
  monthlySalaryPaisa Int
  status             EmployeeStatus @default(ACTIVE)
  deletedAt          DateTime?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  user   User?  @relation(fields: [userId], references: [id], onDelete: Restrict)
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)

  @@index([branchId])
}

// ---------- Catalog (Batch 6) ----------
// Rule: price hamesha paisa (Int). Price badalne par naya PriceVersion banega, purana update nahi hoga.

model Category {
  id        String    @id @default(cuid())
  code      String    @unique
  name      String
  sortOrder Int       @default(0)
  isActive  Boolean   @default(true)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  products Product[]
}

model Product {
  id          String    @id @default(cuid())
  categoryId  String
  code        String    @unique
  name        String
  description String?
  isActive    Boolean   @default(true)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  category Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  variants ProductVariant[]

  @@index([categoryId])
}

model ProductVariant {
  id        String    @id @default(cuid())
  productId String
  code      String    @unique
  name      String
  isActive  Boolean   @default(true)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  product    Product        @relation(fields: [productId], references: [id], onDelete: Restrict)
  prices     PriceVersion[]
  orderItems OrderItem[]

  @@index([productId])
}

model PriceVersion {
  id            String   @id @default(cuid())
  variantId     String
  amountPaisa   Int
  effectiveFrom DateTime @default(now())
  isVerified    Boolean  @default(false) // owner verify kare to true
  note          String?
  createdAt     DateTime @default(now())

  variant    ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  orderItems OrderItem[]

  @@index([variantId, effectiveFrom])
}

// ---------- Orders (Batch 7) ----------
// Rules:
// - Price snapshot: order item mein unitPricePaisa save hota hai. Baad mein price badle to purana order nahi badlega.
// - Idempotency: idempotencyKey unique hai. Same key par dobara duplicate order nahi banega.
// - Totals sirf server calculate karta hai.

enum OrderStatus {
  CONFIRMED
  PAID
  CANCELLED
}

enum OrderType {
  DINE_IN
  TAKEAWAY
  DELIVERY
}

model Order {
  id             String      @id @default(cuid())
  orderNumber    String
  branchId       String
  createdById    String
  orderType      OrderType   @default(TAKEAWAY)
  status         OrderStatus @default(CONFIRMED)
  idempotencyKey String      @unique
  subtotalPaisa  Int
  discountPaisa  Int         @default(0)
  totalPaisa     Int
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  branch    Branch      @relation(fields: [branchId], references: [id], onDelete: Restrict)
  createdBy User        @relation(fields: [createdById], references: [id], onDelete: Restrict)
  items     OrderItem[]

  @@unique([branchId, orderNumber])
  @@index([branchId, createdAt])
}

model OrderItem {
  id                  String  @id @default(cuid())
  orderId             String
  variantId           String
  priceVersionId      String
  productNameSnapshot String
  variantNameSnapshot String
  unitPricePaisa      Int
  quantity            Int
  lineTotalPaisa      Int
  note                String?

  order        Order          @relation(fields: [orderId], references: [id], onDelete: Restrict)
  variant      ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  priceVersion PriceVersion   @relation(fields: [priceVersionId], references: [id], onDelete: Restrict)

  @@index([orderId])
}
