// Khan Burger - Prisma schema
// Batch 3: Identity (users, roles, permissions), branches, sessions, employees, cash registers.
// Rules:
// - Money hamesha paisa (Int) mein. Kabhi float nahi.
// - Branch aur user hard delete nahi honge (isActive / deletedAt).
// - Financial aur audit tables mein cascade delete nahi.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
  TERMINATED
}

// ---------- Identity & Access ----------

model Role {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String?
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       User[]
  permissions RolePermission[]
}

model Permission {
  id          String   @id @default(cuid())
  code        String   @unique
  description String?
  createdAt   DateTime @default(now())

  roles RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  createdAt    DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Restrict)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  @@id([roleId, permissionId])
}

model User {
  id               String    @id @default(cuid())
  username         String    @unique
  fullName         String
  passwordHash     String
  roleId           String
  isActive         Boolean   @default(true)
  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?
  lastLoginAt      DateTime?
  deletedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  role         Role               @relation(fields: [roleId], references: [id], onDelete: Restrict)
  branchAccess UserBranchAccess[]
  sessions     Session[]
  employee     Employee?
  orders       Order[]
  statusEvents OrderStatusEvent[]
  approvalsRequested Approval[]  @relation("ApprovalRequester")
  approvalsDecided   Approval[]  @relation("ApprovalDecider")
  auditLogs          AuditLog[]
  openedShifts      CashShift[] @relation("ShiftOpener")
  closedShifts      CashShift[] @relation("ShiftCloser")
  payments         Payment[]    @relation("PaymentCreator")
  stockMovementsCreated StockMovement[] @relation("StockCreator")

  @@index([roleId])
}

model Session {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique
  expiresAt  DateTime
  lastSeenAt DateTime?
  ipAddress  String?
  userAgent  String?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// ---------- Branches ----------

model Branch {
  id        String    @id @default(cuid())
  code      String    @unique
  name      String
  address   String?
  phone     String?
  timezone  String    @default("Asia/Karachi")
  isActive  Boolean   @default(true)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  userAccess    UserBranchAccess[]
  employees     Employee[]
  cashRegisters CashRegister[]
  orders        Order[]
  cashShifts    CashShift[]
  stockMovements StockMovement[]
}

model UserBranchAccess {
  userId    String
  branchId  String
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)

  @@id([userId, branchId])
  @@index([branchId])
}

model CashRegister {
  id        String   @id @default(cuid())
  branchId  String
  code      String
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)
  cashShifts CashShift[]

  @@unique([branchId, code])
}

// ---------- Staff ----------

model Employee {
  id                 String         @id @default(cuid())
  employeeCode       String         @unique
  userId             String?        @unique
  branchId           String
  fullName           String
  phone              String?
  jobTitle           String
  joiningDate        DateTime
  monthlySalaryPaisa Int
  status             EmployeeStatus @default(ACTIVE)
  deletedAt          DateTime?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  user   User?  @relation(fields: [userId], references: [id], onDelete: Restrict)
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)

  @@index([branchId])
}

// ---------- Catalog (Batch 6) ----------
// Rule: price hamesha paisa (Int). Price badalne par naya PriceVersion banega, purana update nahi hoga.

model Category {
  id        String    @id @default(cuid())
  code      String    @unique
  name      String
  sortOrder Int       @default(0)
  isActive  Boolean   @default(true)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  products Product[]
}

model Product {
  id          String    @id @default(cuid())
  categoryId  String
  code        String    @unique
  name        String
  description String?
  isActive    Boolean   @default(true)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  category Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  variants ProductVariant[]

  @@index([categoryId])
}

model ProductVariant {
  id        String    @id @default(cuid())
  productId String
  code      String    @unique
  name      String
  isActive  Boolean   @default(true)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  product    Product        @relation(fields: [productId], references: [id], onDelete: Restrict)
  prices     PriceVersion[]
  orderItems OrderItem[]
  recipeLines RecipeLine[]

  @@index([productId])
}

model PriceVersion {
  id            String   @id @default(cuid())
  variantId     String
  amountPaisa   Int
  effectiveFrom DateTime @default(now())
  isVerified    Boolean  @default(false) // owner verify kare to true
  note          String?
  createdAt     DateTime @default(now())

  variant    ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  orderItems OrderItem[]

  @@index([variantId, effectiveFrom])
}

// ---------- Orders (Batch 7) ----------
// Rules:
// - Price snapshot: order item mein unitPricePaisa save hota hai. Baad mein price badle to purana order nahi badlega.
// - Idempotency: idempotencyKey unique hai. Same key par dobara duplicate order nahi banega.
// - Totals sirf server calculate karta hai.

enum OrderStatus {
  CONFIRMED
  PREPARING
  READY
  SERVED
  PAID
  CANCELLED
}

enum OrderType {
  DINE_IN
  TAKEAWAY
  DELIVERY
}

model Order {
  id             String      @id @default(cuid())
  orderNumber    String
  branchId       String
  createdById    String
  orderType      OrderType   @default(TAKEAWAY)
  status         OrderStatus @default(CONFIRMED)
  idempotencyKey String      @unique
  subtotalPaisa  Int
  discountPaisa  Int         @default(0)
  totalPaisa     Int
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  branch       Branch             @relation(fields: [branchId], references: [id], onDelete: Restrict)
  createdBy    User               @relation(fields: [createdById], references: [id], onDelete: Restrict)
  items        OrderItem[]
  statusEvents OrderStatusEvent[]
  payments     Payment[]

  @@unique([branchId, orderNumber])
  @@index([branchId, createdAt])
}

model OrderItem {
  id                  String  @id @default(cuid())
  orderId             String
  variantId           String
  priceVersionId      String
  productNameSnapshot String
  variantNameSnapshot String
  unitPricePaisa      Int
  quantity            Int
  lineTotalPaisa      Int
  note                String?

  order        Order          @relation(fields: [orderId], references: [id], onDelete: Restrict)
  variant      ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  priceVersion PriceVersion   @relation(fields: [priceVersionId], references: [id], onDelete: Restrict)

  @@index([orderId])
}

// ---------- Order status history (Batch 8) ----------
// Har status change ka record. Delete ya update nahi hota.

model OrderStatusEvent {
  id          String      @id @default(cuid())
  orderId     String
  fromStatus  OrderStatus
  toStatus    OrderStatus
  changedById String
  reason      String?
  createdAt   DateTime    @default(now())

  order     Order @relation(fields: [orderId], references: [id], onDelete: Restrict)
  changedBy User  @relation(fields: [changedById], references: [id], onDelete: Restrict)

  @@index([orderId, createdAt])
}

// ---------- Approvals, Outbox, Audit (Batch 9) ----------

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum OutboxStatus {
  PENDING
  SENT
  FAILED
}

model Approval {
  id            String         @id @default(cuid())
  type          String         // "ORDER_CANCEL"
  entityType    String         // "Order"
  entityId      String
  status        ApprovalStatus @default(PENDING)
  reason        String
  decisionNote  String?
  requestedById String
  decidedById   String?
  createdAt     DateTime       @default(now())
  decidedAt     DateTime?

  requestedBy User  @relation("ApprovalRequester", fields: [requestedById], references: [id], onDelete: Restrict)
  decidedBy   User? @relation("ApprovalDecider", fields: [decidedById], references: [id], onDelete: Restrict)

  @@index([entityType, entityId])
  @@index([status, createdAt])
}

// Notification ya side-effect ka pakka record. Worker yahin se padhta hai.
model OutboxEvent {
  id        String       @id @default(cuid())
  type      String
  payload   Json
  status    OutboxStatus @default(PENDING)
  attempts  Int          @default(0)
  lastError String?
  createdAt DateTime     @default(now())
  sentAt    DateTime?

  @@index([status, createdAt])
}

// Append-only. App ko is table par UPDATE/DELETE ka kaam nahi dena.
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String
  action     String
  entityType String
  entityId   String
  before     Json?
  after      Json?
  reason     String?
  createdAt  DateTime @default(now())

  actor User @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([entityType, entityId])
  @@index([actorId, createdAt])
}

// ---------- Cash shifts (Batch 10) ----------
// Rule: paisa mein. Shift band hone ke baad uska record change nahi hota.

enum CashShiftStatus {
  OPEN
  CLOSED
}

model CashShift {
  id                 String          @id @default(cuid())
  branchId           String
  cashRegisterId     String
  openedById         String
  closedById         String?
  status             CashShiftStatus @default(OPEN)
  openingCashPaisa   Int
  expectedCashPaisa  Int?
  countedCashPaisa   Int?
  variancePaisa      Int?
  varianceReason     String?
  openedAt           DateTime        @default(now())
  closedAt           DateTime?

  branch       Branch       @relation(fields: [branchId], references: [id], onDelete: Restrict)
  cashRegister CashRegister @relation(fields: [cashRegisterId], references: [id], onDelete: Restrict)
  openedBy     User         @relation("ShiftOpener", fields: [openedById], references: [id], onDelete: Restrict)
  closedBy     User?        @relation("ShiftCloser", fields: [closedById], references: [id], onDelete: Restrict)
  payments     Payment[]

  @@index([cashRegisterId, status])
  @@index([branchId, openedAt])
}

// ---------- Payments (Batch 10 Part 2) ----------

enum PaymentMethod {
  CASH
  JAZZCASH
  EASYPAISA
  BANK_TRANSFER
  CARD
}

enum PaymentStatus {
  COMPLETED
  REVERSED
}

// Ek order ki ek hi payment (abhi partial payment nahi). Reversal ke liye status badlega, row delete nahi hogi.
model Payment {
  id              String        @id @default(cuid())
  orderId         String        @unique
  cashShiftId     String
  method          PaymentMethod
  status          PaymentStatus @default(COMPLETED)
  amountPaisa     Int
  reference       String?
  idempotencyKey  String        @unique
  createdById     String
  createdAt       DateTime      @default(now())

  order     Order     @relation(fields: [orderId], references: [id], onDelete: Restrict)
  cashShift CashShift @relation(fields: [cashShiftId], references: [id], onDelete: Restrict)
  createdBy User      @relation("PaymentCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([cashShiftId, method, status])
}

// ---------- Inventory ledger (Batch 11) ----------
// Unit: g, ml, pcs (base units). Quantities integer hain.

enum StockMovementType {
  PURCHASE
  SALE_DEDUCTION
  WASTAGE
  ADJUSTMENT
}

model InventoryItem {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  unit      String   // "g", "ml", "pcs"
  createdAt DateTime @default(now())

  recipeLines    RecipeLine[]
  stockMovements StockMovement[]
}

// Ek variant ki recipe: ek ingredient ki kitni quantity (base unit mein) per 1 item
model RecipeLine {
  id              String @id @default(cuid())
  variantId       String
  inventoryItemId String
  quantityBase    Int

  variant       ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  inventoryItem InventoryItem  @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)

  @@unique([variantId, inventoryItemId])
}

// Append-only ledger. Quantity negative = stock out, positive = stock in.
model StockMovement {
  id              String            @id @default(cuid())
  branchId        String
  inventoryItemId String
  type            StockMovementType
  quantityBase    Int
  orderId         String?
  reason          String?
  createdById     String
  createdAt       DateTime          @default(now())

  branch        Branch        @relation(fields: [branchId], references: [id], onDelete: Restrict)
  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)
  createdBy     User          @relation("StockCreator", fields: [createdById], references: [id], onDelete: Restrict)

  // Ek order par ek item ki ek hi deduction
  @@unique([orderId, inventoryItemId, type])
  @@index([branchId, inventoryItemId])
}
